<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    android:importantForAutofill="no"
    tools:context=".activity.SignUpActivity">


    <RelativeLayout
        android:id="@+id/rel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/white">


        <ImageView
            android:id="@+id/back"
            android:layout_width="@dimen/_27sdp"
            android:layout_height="@dimen/_27sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:padding="@dimen/_2sdp"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/back"
            android:fontFamily="@font/bold"
            android:text="SignUp"
            android:textColor="@color/black"
            android:textSize="@dimen/_13ssp" />


    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_below="@id/rel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/_15sdp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/select_image_card"
                android:layout_centerHorizontal="true"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                app:cardCornerRadius="@dimen/_80sdp"
                app:strokeColor="@color/transparent"
                app:cardBackgroundColor="#324580F4"
                android:layout_gravity="center_horizontal"
                android:layout_margin="@dimen/_8sdp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:visibility="visible"
                        android:id="@+id/gallery_icon"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:src="@drawable/gallery_select"
                        android:layout_gravity="center"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/profile_image"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:visibility="gone"/>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:text="Student Full  Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fullName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/fullNameEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    android:inputType="text"

                 />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:text="Standard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <AutoCompleteTextView
                android:id="@+id/autoCompleteTextViewstanderd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Standard"
                android:padding="@dimen/_12sdp"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginTop="@dimen/_5sdp"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black"
                android:background="@drawable/bg_gradient_edit_text"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:text="Div"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <AutoCompleteTextView
                android:id="@+id/autoCompleteTextViewClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Div"
                android:padding="@dimen/_12sdp"
                android:focusable="false"
                android:clickable="true"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/_5sdp"
                app:boxStrokeColor="@color/black"
                android:background="@drawable/bg_gradient_edit_text"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:text="Age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/age"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ageEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"

                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:text="Session year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/year"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/yearEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    android:inputType="numberSigned" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:text="Father's Name(optional)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fatherName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/fatherNameEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    android:inputType="textEnableTextConversionSuggestions" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:text="Father's Phone Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/fPhoneNum"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:importantForAutofill="no"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/fPhoneNumEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:text="Mother's Name(optional)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/motherNAME"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/mothersName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="postalAddress"
                    android:inputType="textAutoComplete"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:text="Mother's Phone Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/mPhoneNumber"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/mPhoneEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="postalCode"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>



            <TextView
                android:text="Guardian's Name(optional)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/guardianNAME"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/guardianName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:text="Guardian's Phone Number(optional)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/guardianNumber"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/guardianPhoneEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    android:autofillHints="postalCode"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:text="Email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:textColor="@color/black"
                app:boxStrokeColor="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:text="Password(create new)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_below="@+id/username"
                android:textColor="@color/bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:textColorHint="@color/greay"
                app:hintTextColor="@color/black"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="@color/black"
                android:layout_below="@id/passText"
                app:boxStrokeColor="@color/black"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/black">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_edit_text"
                    android:textColor="@color/black"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>
            <RelativeLayout
                android:layout_below="@id/name"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_alignParentBottom="true"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/rl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/dark_greay"
                    android:text="By continuing, you agree to Aaradhya school bus service\"
                    android:layout_centerHorizontal="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/rl"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/terms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/skyBlue"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:textSize="@dimen/_10ssp"
                        android:text="T&amp;C "

                        />

                    <TextView
                        android:id="@+id/and"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dark_greay"
                        android:layout_gravity="center_vertical"
                        android:text=" and "
                        android:layout_toRightOf="@id/terms"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@id/rl"
                        />
                    <TextView
                        android:id="@+id/privacyPolicy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/skyBlue"
                        android:layout_gravity="center_vertical"
                        android:textSize="@dimen/_10ssp"
                        android:text=" Privacy Policy."
                        android:layout_toRightOf="@id/and"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@id/rl"
                        />

                </LinearLayout>

            </RelativeLayout>
            <FrameLayout
                android:id="@+id/btnFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_below="@id/forgotPass"
                android:layout_marginTop="@dimen/_10sdp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendOTPBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:backgroundTint="@color/appColor"
                    android:text="Send OTP"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:cornerRadius="@dimen/_10sdp" />

                <ProgressBar
                    android:id="@+id/progressbar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/appColor"
                    android:visibility="invisible"/>

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
